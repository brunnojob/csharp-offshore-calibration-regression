{
  "repository": "brunnojob/csharp-offshore-calibration-regression",
  "inputs": [
    ".proof/scenarios.json",
    "examples/input.txt"
  ],
  "cases": [
    {
      "name": "dotnet build && dotnet run --no-build -- --self-test && dotnet run --no-build < examples/input.txt",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "dotnet build && dotnet run --no-build -- --self-test && dotnet run --no-build < examples/input.txt"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "Application demonstration with checked output",
      "argv": [
        "dotnet",
        "run",
        "--no-build",
        "--"
      ],
      "input": "examples/input.txt",
      "contains": [
        "\"Slope\"",
        "corrected="
      ]
    },
    {
      "name": "Reject an empty capture",
      "argv": [
        "dotnet",
        "run",
        "--no-build",
        "--"
      ],
      "stdin": "",
      "exit": 2
    },
    {
      "name": "Reject malformed input",
      "argv": [
        "dotnet",
        "run",
        "--no-build",
        "--"
      ],
      "stdin": "broken,input\n",
      "exit": 2
    },
    {
      "name": "Reject unsupported invocation",
      "argv": [
        "dotnet",
        "run",
        "--no-build",
        "--",
        "--unsupported"
      ],
      "exit": 2,
      "contains": [
        "arguments"
      ]
    },
    {
      "name": "Reject an oversized input record",
      "argv": [
        "dotnet",
        "run",
        "--no-build",
        "--"
      ],
      "stdin": "\n",
      "exit": 2,
      "contains": [
        "record too large"
      ]
    }
  ]
}
